module returns

fn return1() -> i8 {
  0
}

fn return2() -> i8 {
  if true {
    return 0
  }
  1
}

fn return3() -> i8 {
  if true {
    return 0
  } else {
    return 1
  }
  2
}

fn noop() -> () {
  ()
}

fn unit_if_no_else(cond: bool) -> () {
  if cond {
    noop ();
  }
}

fn unit_early_return_if(cond: bool) -> () {
  if cond {
    return ();
  }
  if cond {
    noop ();
  }
}

fn unit_for_loop(n: i64) -> () {
  let i: i64 = 0;
  for i < n {
    i <- i + 1;
    noop ();
  }
}

fn value_if_else_implicit(cond: bool) -> i64 {
  if cond {
    1
  } else {
    2
  }
}

fn value_for_early_return(n: i64) -> i64 {
  let i: i64 = 0;
  for i < n {
    if i == 5 {
      return i;
    }
    i <- i + 1;
  }
  0
}

type Choice = variant {
  a i64,
  b i64
}

fn match_exhaustive_value(t: Choice) -> i64 {
  match t {
    a x => x,
    b y => y + 1
  }
}

fn match_wildcard_value(t: Choice) -> i64 {
  match t {
    a x => x,
    _ => 0
  }
}

fn unit_match_exhaustive(t: Choice) -> () {
  match t {
    a v => {
      noop ();
    },
    b v => {
      noop ();
    }
  }
}
