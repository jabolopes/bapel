unit {
  module anonymous_structs
  filename "tests/testdata/in/anonymous_structs.in"
  base
}

decls {
  /* tests/testdata/in/anonymous_structs.in:11-17 */ export type Outer = struct{label: i64, inner: struct{a: i64, b: i64}}
  /* tests/testdata/in/anonymous_structs.in:3-9 */ export type Expr = variant{lit i64, add struct{lhs: i64, rhs: i64}}
  /* tests/testdata/in/anonymous_structs.in:19-24 */ export eval: Expr -> i64
  /* tests/testdata/in/anonymous_structs.in:30-32 */ export make_expr: () -> Expr
  /* tests/testdata/in/anonymous_structs.in:26-28 */ export sum_point: struct{x: i64, y: i64} -> i64
}

/* tests/testdata/in/anonymous_structs.in:19-24 */export fn eval(e: Expr) -> i64 {
  (case e:Expr {
      lit x -> x:i64
      add p -> ((+:(forall ['c] ('c, 'c) -> 'c) [i64]):((i64, i64) -> i64) ((p:struct{lhs: i64, rhs: i64}.lhs):i64, (p:struct{lhs: i64, rhs: i64}.rhs):i64):(i64, i64)):i64}):i64
}:i64

/* tests/testdata/in/anonymous_structs.in:26-28 */export fn sum_point(p: struct{x: i64, y: i64}) -> i64 {
  ((+:(forall ['c] ('c, 'c) -> 'c) [i64]):((i64, i64) -> i64) ((p:struct{x: i64, y: i64}.x):i64, (p:struct{x: i64, y: i64}.y):i64):(i64, i64)):i64
}:i64

/* tests/testdata/in/anonymous_structs.in:30-32 */export fn make_expr() -> Expr {
  (variant{Expr add = struct{lhs = (1:(forall ['b] 'b) [i64]):i64, rhs = (2:(forall ['c] 'c) [i64]):i64}:struct{lhs: i64, rhs: i64}}):Expr
}:Expr
