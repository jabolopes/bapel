/* tests/testdata/in/recursive_types.in:15-20 */export fn mkNode(v: i64) -> Node {
  struct{val = v:i64, next = ((SharedPtr::null:(forall ['b] () -> SharedPtr 'b) [Node]):(() -> SharedPtr Node) ():()):(SharedPtr Node)}:struct{val: i64, next: SharedPtr mu 'b. struct{val: i64, next: SharedPtr 'b}}
}:struct{val: i64, next: SharedPtr mu 'a. struct{val: i64, next: SharedPtr 'a}}

/* tests/testdata/in/recursive_types.in:28-33 */export fn sumList(l: Ptr IntList) -> i64 {
  (case ((Ptr::get:(forall ['c] Ptr 'c -> 'c) [IntList]):(Ptr IntList -> IntList) l:(Ptr IntList)):IntList {
      nil u -> (0:(forall ['d] 'd) [i64]):i64
      cons pair -> ((+:(forall ['j] ('j, 'j) -> 'j) [i64]):((i64, i64) -> i64) ((pair:(i64, SharedPtr mu 'j. variant{nil (), cons (i64, SharedPtr 'j)}).0):i64, (sumList:(Ptr IntList -> i64) (((SharedPtr::get:(forall ['k] Ptr (SharedPtr 'k) -> Ptr 'k) [mu 'i. variant{nil (), cons (i64, SharedPtr 'i)}]):(Ptr (SharedPtr mu 'k. variant{nil (), cons (i64, SharedPtr 'k)}) -> Ptr mu 'k. variant{nil (), cons (i64, SharedPtr 'k)}) (((Ptr::mk:(forall ['l] 'l -> Ptr 'l) [SharedPtr mu 'g. variant{nil (), cons (i64, SharedPtr 'g)}]):(SharedPtr mu 'l. variant{nil (), cons (i64, SharedPtr 'l)} -> Ptr (SharedPtr mu 'l. variant{nil (), cons (i64, SharedPtr 'l)})) (pair:(i64, SharedPtr mu 'l. variant{nil (), cons (i64, SharedPtr 'l)}).1):(SharedPtr mu 'l. variant{nil (), cons (i64, SharedPtr 'l)})):(Ptr (SharedPtr mu 'l. variant{nil (), cons (i64, SharedPtr 'l)})))):(Ptr mu 'l. variant{nil (), cons (i64, SharedPtr 'l)}))):i64):(i64, i64)):i64}):i64
}:i64

/* tests/testdata/in/recursive_types.in:41-43 */export fn mkLeaf['a ∗](x: 'a) -> Tree 'a {
