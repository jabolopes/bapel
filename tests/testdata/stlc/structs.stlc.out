  set r1:Point {x = (3:(forall ['f] 'f) [i8]):i8, y = (4:(forall ['g] 'g) [i16]):i16}:Point
  (r1:Point <- set r1:Point {x = (3:(forall ['h] 'h) [i8]):i8, y = (4:(forall ['i] 'i) [i16]):i16}:Point):Point
  set r1:Point {0 = (3:(forall ['j] 'j) [i8]):i8, 1 = (4:(forall ['k] 'k) [i16]):i16}:Point
  (r1:Point <- set r1:Point {0 = (3:(forall ['l] 'l) [i8]):i8, 1 = (4:(forall ['m] 'm) [i16]):i16}:Point):Point
  (let r: Point = r1:Point):Point
  r:Point
}:Point

/* tests/testdata/stlc/structs.stlc.in:60-64 */fn mkPolymorphicStruct() -> () {
