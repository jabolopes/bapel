/* tests/testdata/stlc/structs.stlc.in:43-58 */fn mkPoint3() -> Point {
  (let r1: Point = struct{x = (0:(forall ['b] 'b) [i8]):i8, y = (0:(forall ['c] 'c) [i16]):i16}:struct{x: i8, y: i16}):Point
  (let r2: Point = struct{x = (0:(forall ['d] 'd) [i8]):i8, y = (0:(forall ['e] 'e) [i16]):i16}:struct{x: i8, y: i16}):Point
  (let x: i8 = (r1:Point.x):i8):i8
