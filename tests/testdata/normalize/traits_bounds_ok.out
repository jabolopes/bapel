unit {
  module traits_bounds_ok
  filename "tests/testdata/in/traits_bounds_ok.in"
  base
}

impls {
  "tests/testdata/in/ptr.h"
  "tests/testdata/in/vector.h"
}

implDecls {
  /* <stdin>:1 */ export Ptr::get: forall ['a] Ptr 'a -> 'a
  /* <stdin>:1 */ export Ptr::mk: forall ['a] 'a -> Ptr 'a
  /* <stdin>:1 */ export vector_get: forall ['a] (Ptr (Vector 'a), i64) -> 'a
}

decls {
  /* tests/testdata/in/traits_bounds_ok.in:8 */ export type Ptr :: ∗ -> ∗
  /* tests/testdata/in/traits_bounds_ok.in:15 */ export type Vector :: ∗ -> ∗
  /* tests/testdata/in/traits_bounds_ok.in:63-66 */ export type IntList = mu 'self. variant{nil (), cons (i64, Ptr 'self)}
  /* tests/testdata/in/traits_bounds_ok.in:48-51 */ export type Color = variant{red (), green ()}
  /* tests/testdata/in/traits_bounds_ok.in:36-39 */ export type Node = mu 'self. struct{val: i64, next: Ptr 'self}
  /* tests/testdata/in/traits_bounds_ok.in:24-27 */ export type Point = struct{x: i64, y: i64}
  /* tests/testdata/in/traits_bounds_ok.in:10-12 */ export trait Size {
  fn size(s: Ptr Self) -> i64
}
  /* tests/testdata/in/traits_bounds_ok.in:77-79 */ export print_size: forall ['t: Size] Ptr 't -> i64
  /* tests/testdata/in/traits_bounds_ok.in:81-83 */ export print_size_dot: forall ['t: Size] Ptr 't -> i64
  /* tests/testdata/in/traits_bounds_ok.in:98-101 */ export test_color: () -> i64
  /* tests/testdata/in/traits_bounds_ok.in:103-105 */ export test_int_list: Ptr IntList -> i64
  /* tests/testdata/in/traits_bounds_ok.in:94-96 */ export test_node: Ptr Node -> i64
  /* tests/testdata/in/traits_bounds_ok.in:89-92 */ export test_point: () -> i64
  /* tests/testdata/in/traits_bounds_ok.in:85-87 */ export test_vector: Ptr (Vector i64) -> i64
}

/* tests/testdata/in/traits_bounds_ok.in:77-79 */export fn print_size['t ∗](x: Ptr 't) -> i64 {
  Size::size x
}

/* tests/testdata/in/traits_bounds_ok.in:81-83 */export fn print_size_dot['t ∗](x: Ptr 't) -> i64 {
  x.size ()
}

/* tests/testdata/in/traits_bounds_ok.in:85-87 */export fn test_vector(v: Ptr (Vector i64)) -> i64 {
  + (print_size [Vector i64] v, print_size_dot [Vector i64] v)
}

/* tests/testdata/in/traits_bounds_ok.in:89-92 */export fn test_point() -> i64 {
  let p: Point = struct{x = 10, y = 32}
  + (print_size [Point] (Ptr::mk p), print_size_dot [Point] (Ptr::mk p))
}

/* tests/testdata/in/traits_bounds_ok.in:94-96 */export fn test_node(n: Ptr Node) -> i64 {
  print_size [Node] n
}

/* tests/testdata/in/traits_bounds_ok.in:98-101 */export fn test_color() -> i64 {
  let c: Color = variant{Color red = ()}
  print_size [Color] (Ptr::mk c)
}

/* tests/testdata/in/traits_bounds_ok.in:103-105 */export fn test_int_list(l: Ptr IntList) -> i64 {
  print_size [IntList] l
}

/* tests/testdata/in/traits_bounds_ok.in:17-21 */impl ['a] Size for Vector 'a {
  fn size(v: Ptr Self) -> i64 {
  0
}
}

/* tests/testdata/in/traits_bounds_ok.in:29-33 */impl Size for Point {
  fn size(p: Ptr Self) -> i64 {
  + (Ptr::get p.x, Ptr::get p.y)
}
}

/* tests/testdata/in/traits_bounds_ok.in:41-45 */impl Size for Node {
  fn size(n: Ptr Self) -> i64 {
  Ptr::get n.val
}
}

/* tests/testdata/in/traits_bounds_ok.in:53-60 */impl Size for Color {
  fn size(c: Ptr Self) -> i64 {
  case Ptr::get c {
      red u -> 1
      _ -> 2}
}
}

/* tests/testdata/in/traits_bounds_ok.in:68-75 */impl Size for IntList {
  fn size(l: Ptr Self) -> i64 {
  case Ptr::get l {
      nil u -> 0
      cons pair -> pair.0}
}
}
