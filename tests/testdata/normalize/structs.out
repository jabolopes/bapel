/* tests/testdata/in/structs.in:46-61 */fn mkPoint3() -> Point {
  let r1: Point = struct{x = 0, y = 0}
  let r2: Point = struct{x = 0 [i8], y = 0 [i16]}
  let x: i8 = r1.x
  let y: i16 = r1.y
  set r1 {x = 3, y = 4}
  r1 <- set r1 {x = 3, y = 4}
  set r1 {0 = 3, 1 = 4}
  r1 <- set r1 {0 = 3, 1 = 4}
  let r: Point = r1
  r
}

