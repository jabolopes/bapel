module array

imports {
  bapel.core "./bapel/core.bpl"
}

importDecls {
  /* bapel.core:1 */ pub type Ptr :: ∗ -> ∗
  /* bapel.core:1 */ pub type core::AbsPoint
  /* bapel.core:1 */ pub type core::Point = struct{x: i32, y: i32}
  /* bapel.core:1 */ pub Ptr::get: forall ['a] Ptr 'a -> 'a
  /* bapel.core:1 */ pub Ptr::mk: forall ['a] 'a -> Ptr 'a
  /* bapel.core:1 */ pub Ptr::set: forall ['a] (Ptr 'a, 'a) -> ()
  /* bapel.core:1 */ pub arr::get: forall ['a] (['a, 10], i64) -> 'a
  /* bapel.core:1 */ pub arr::mk: forall ['a] () -> ['a, 10]
  /* bapel.core:1 */ pub arr::set: forall ['a] (['a, 10], i64, 'a) -> ()
  /* bapel.core:1 */ pub core::abs: forall ['a] 'a -> 'a
  /* bapel.core:1 */ pub core::absPointX: core::AbsPoint -> i32
  /* bapel.core:1 */ pub core::eprint: forall ['a] 'a -> ()
  /* bapel.core:1 */ pub core::i16_to_i32: i16 -> i32
  /* bapel.core:1 */ pub core::i16_to_i64: i16 -> i64
  /* bapel.core:1 */ pub core::i32_to_i64: i32 -> i64
  /* bapel.core:1 */ pub core::i64_to_i32: i64 -> i32
  /* bapel.core:1 */ pub core::i8_to_i32: i8 -> i32
  /* bapel.core:1 */ pub core::i8_to_i64: i8 -> i64
  /* bapel.core:1 */ pub core::mkAbsPoint: () -> core::AbsPoint
  /* bapel.core:1 */ pub core::noopAbsPoint: core::AbsPoint -> ()
  /* bapel.core:1 */ pub core::noopPoint: core::Point -> ()
  /* bapel.core:1 */ pub core::print: forall ['a] 'a -> ()
  /* bapel.core:1 */ pub core::squareRoot: f32 -> f32
  /* bapel.core:1 */ pub core::time: () -> (i64, i64)
}

file "tests/testdata/in/array.in" (base) {
  imports {
    /* tests/testdata/in/array.in:5 */bapel.core
  }
  decls {
    /* tests/testdata/in/array.in:8-10 */ mkArray1: () -> [i8, 10]
    /* tests/testdata/in/array.in:12-24 */ mkArray2: () -> [i8, 10]
  }
  functions {
    /* tests/testdata/in/array.in:8-10 */fn mkArray1() -> [i8, 10] {
  arr::mk [i8] ()
}
    /* tests/testdata/in/array.in:12-24 */fn mkArray2() -> [i8, 10] {
  let a: [i8, 10] = arr::mk [i8] ()
  let v1: i8 = arr::get [i8] (a, 0 [i64])
  let v2: i8 = arr::get [i8] (a, 0)
  let i: i64 = 0
  arr::set [i8] (a, i, 10 [i8])
  arr::set [i8] (a, i, 10)
  let r: [i8, 10] = a
  r
}
  }
}
