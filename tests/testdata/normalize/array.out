decls {
  /* tests/testdata/in/array.in:8-10 */ mkArray1: () -> [i8, 10]
  /* tests/testdata/in/array.in:12-24 */ mkArray2: () -> [i8, 10]
}

/* tests/testdata/in/array.in:8-10 */fn mkArray1() -> [i8, 10] {
  arr::mk [i8] ()
}

/* tests/testdata/in/array.in:12-24 */fn mkArray2() -> [i8, 10] {
  let a: [i8, 10] = arr::mk [i8] ()
  let v1: i8 = arr::get [i8] (a, 0 [i64])
  let v2: i8 = arr::get [i8] (a, 0)
  let i: i64 = 0
  arr::set [i8] (a, i, 10 [i8])
  arr::set [i8] (a, i, 10)
  let r: [i8, 10] = a
  r
}
