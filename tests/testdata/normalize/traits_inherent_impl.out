unit {
  module traits_inherent_impl
  filename "tests/testdata/in/traits_inherent_impl.in"
  base
}

impls {
  "tests/testdata/in/ptr.h"
  "tests/testdata/in/vector.h"
}

implDecls {
  /* <stdin>:1 */ export Ptr::get: forall ['a] Ptr 'a -> 'a
  /* <stdin>:1 */ export Ptr::mk: forall ['a] 'a -> Ptr 'a
  /* <stdin>:1 */ export vector_get: forall ['a] (Ptr (Vector 'a), i64) -> 'a
}

decls {
  /* tests/testdata/in/traits_inherent_impl.in:8 */ export type Ptr :: ∗ -> ∗
  /* tests/testdata/in/traits_inherent_impl.in:11 */ export type Vector :: ∗ -> ∗
  /* tests/testdata/in/traits_inherent_impl.in:71-74 */ export type IntList = mu 'self. variant{nil (), cons (i64, Ptr 'self)}
  /* tests/testdata/in/traits_inherent_impl.in:56-59 */ export type Color = variant{red (), green ()}
  /* tests/testdata/in/traits_inherent_impl.in:40-43 */ export type Node = mu 'self. struct{val: i64, next: Ptr 'self}
  /* tests/testdata/in/traits_inherent_impl.in:20-23 */ export type Point = struct{x: i64, y: i64}
  /* tests/testdata/in/traits_inherent_impl.in:120-129 */ export test_color: () -> bool
  /* tests/testdata/in/traits_inherent_impl.in:131-147 */ export test_int_list: Ptr IntList -> i64
  /* tests/testdata/in/traits_inherent_impl.in:111-118 */ export test_node: Ptr Node -> i64
  /* tests/testdata/in/traits_inherent_impl.in:98-109 */ export test_point: () -> i64
  /* tests/testdata/in/traits_inherent_impl.in:92-96 */ export test_vector: Ptr (Vector i64) -> i64
}

/* tests/testdata/in/traits_inherent_impl.in:92-96 */export fn test_vector(v: Ptr (Vector i64)) -> i64 {
  let a: i64 = v.get 0
  let b: i64 = Vector::get [i64] (v, 1)
  + (a, b)
}

/* tests/testdata/in/traits_inherent_impl.in:98-109 */export fn test_point() -> i64 {
  let a: i64 = Point::mk (1, 2).sum ()
  let p1: Point = Point::mk (3, 4)
  let b: i64 = p1.sum
  let ref_p1: Ptr Point = Ptr::mk p1
  let c: i64 = ref_p1.sum ()
  let d: i64 = ref_p1.sum
  let p2: Point = Point::mk (5, 6)
  let p3: Point = p1.add (Ptr::mk p2)
  let e: i64 = Point::sum (Ptr::mk p3)
  + (+ (+ (+ (a, b), c), d), e)
}

/* tests/testdata/in/traits_inherent_impl.in:111-118 */export fn test_node(n: Ptr Node) -> i64 {
  let a: i64 = n.get_val ()
  let b: i64 = n.get_val
  let c: i64 = n.next_val ()
  let d: i64 = n.next_val
  let e: i64 = Node::get_val n
  + (+ (+ (+ (a, b), c), d), e)
}

/* tests/testdata/in/traits_inherent_impl.in:120-129 */export fn test_color() -> bool {
  let c1: Color = variant{Color red = ()}
  let a: bool = c1.is_red ()
  let b: bool = c1.is_red
  let ref_c1: Ptr Color = Ptr::mk c1
  let c: bool = ref_c1.is_red ()
  let d: bool = ref_c1.is_red
  let e: bool = Color::is_red (Ptr::mk c1)
  && (&& (&& (&& (a, b), c), d), e)
}

/* tests/testdata/in/traits_inherent_impl.in:131-147 */export fn test_int_list(l: Ptr IntList) -> i64 {
  let empty: IntList = variant{IntList nil = ()}
  let a: bool = empty.is_nil ()
  let b: bool = empty.is_nil
  let c: bool = l.is_nil ()
  let d: bool = l.is_nil
  let s1: i64 = empty.sum ()
  let s2: i64 = empty.sum
  let s3: i64 = l.sum ()
  let s4: i64 = l.sum
  let s5: i64 = IntList::sum l
  ifelse (&& (&& (&& (a, b), c), d), {
    + (s1, s2)
  }, {
    + (+ (s3, s4), s5)
  })
}

/* tests/testdata/in/traits_inherent_impl.in:13-17 */impl ['a] Vector 'a {
  fn get(v: Ptr Self, i: i64) -> 'a {
  vector_get (v, i)
}
}

/* tests/testdata/in/traits_inherent_impl.in:25-37 */impl Point {
  fn mk(x: i64, y: i64) -> Point {
  struct{x = x, y = y}
}
  fn sum(p: Ptr Self) -> i64 {
  + (Ptr::get p.x, Ptr::get p.y)
}
  fn add(a: Ptr Self, b: Ptr Point) -> Point {
  struct{x = + (Ptr::get a.x, Ptr::get b.x), y = + (Ptr::get a.y, Ptr::get b.y)}
}
}

/* tests/testdata/in/traits_inherent_impl.in:45-53 */impl Node {
  fn get_val(n: Ptr Self) -> i64 {
  Ptr::get n.val
}
  fn next_val(n: Ptr Self) -> i64 {
  Ptr::get n.next.get_val ()
}
}

/* tests/testdata/in/traits_inherent_impl.in:61-68 */impl Color {
  fn is_red(c: Ptr Self) -> bool {
  case Ptr::get c {
      red u -> true
      _ -> false}
}
}

/* tests/testdata/in/traits_inherent_impl.in:76-90 */impl IntList {
  fn is_nil(l: Ptr Self) -> bool {
  case Ptr::get l {
      nil u -> true
      _ -> false}
}
  fn sum(l: Ptr Self) -> i64 {
  case Ptr::get l {
      nil u -> 0
      cons pair -> + (pair.0, pair.1.sum ())}
}
}
