}

/* tests/testdata/in/tuple.in:35-47 */fn mkPoint3() -> Point {
  let r1: Point = (1, 2)
  let r2: Point = (1 [i8], 2 [i16])
  let x: i8 = r1.0
  let y: i16 = r1.1
  set r1 {0 = 3, 1 = 4}
  r1 <- set r1 {0 = 3, 1 = 4}
  let r: Point = r1
  r1
}
