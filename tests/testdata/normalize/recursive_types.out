  fn trim_suffix(s: Ptr Self, suff: Ptr String) -> bool {
  ifthen (String::ends_with (s, suff), {
    let sv: StringView = String::view s
    StringView::remove_suffix (Ptr::mk sv, String::size suff)
    Ptr::set (s, StringView::to_string sv)
    return true
  })
  false
}
