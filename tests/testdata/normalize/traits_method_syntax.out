unit {
  module traits_method_syntax
  filename "tests/testdata/in/traits_method_syntax.in"
  base
}

impls {
  "tests/testdata/in/ptr.h"
}

implDecls {
  /* <stdin>:1 */ export Ptr::get: forall ['a] Ptr 'a -> 'a
  /* <stdin>:1 */ export Ptr::mk: forall ['a] 'a -> Ptr 'a
}

decls {
  /* tests/testdata/in/traits_method_syntax.in:7 */ type Ptr :: ∗ -> ∗
  /* tests/testdata/in/traits_method_syntax.in:17 */ type S = struct{x: i64}
  /* tests/testdata/in/traits_method_syntax.in:13-15 */ trait Add {
  fn add(a: Ptr Self, b: Ptr Self) -> i64
}
  /* tests/testdata/in/traits_method_syntax.in:9-11 */ trait Size {
  fn size(s: Ptr Self) -> i64
}
  /* tests/testdata/in/traits_method_syntax.in:31-33 */ make_s: i64 -> S
  /* tests/testdata/in/traits_method_syntax.in:35-37 */ printSize: forall ['t: Size] Ptr 't -> i64
  /* tests/testdata/in/traits_method_syntax.in:39-62 */ run: () -> i64
}

/* tests/testdata/in/traits_method_syntax.in:31-33 */fn make_s(val: i64) -> S {
  struct{x = val}
}

/* tests/testdata/in/traits_method_syntax.in:35-37 */fn printSize['t ∗](x: Ptr 't) -> i64 {
  x.size ()
}

/* tests/testdata/in/traits_method_syntax.in:39-62 */fn run() -> i64 {
  let a: i64 = make_s 10.size ()
  let s1: S = make_s 20
  let b: i64 = s1.size
  let ref_s1: Ptr S = Ptr::mk s1
  let c: i64 = ref_s1.size ()
  let d: i64 = printSize [S] (Ptr::mk s1)
  let s2: S = make_s 30
  let e: i64 = s1.add (Ptr::mk s2)
  let f: i64 = ref_s1.size
  + (+ (+ (+ (+ (a, b), c), d), e), f)
}

/* tests/testdata/in/traits_method_syntax.in:19-23 */impl Size for S {
  fn size(s: Ptr Self) -> i64 {
  Ptr::get s.x
}
}

/* tests/testdata/in/traits_method_syntax.in:25-29 */impl Add for S {
  fn add(a: Ptr Self, b: Ptr Self) -> i64 {
  + (Ptr::get a.x, Ptr::get b.x)
}
}
