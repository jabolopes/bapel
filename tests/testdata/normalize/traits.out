module traits

impls {
  "tests/testdata/in/ptr.h"
  "tests/testdata/in/vector.h"
}

file "tests/testdata/in/traits.in" (base) {
  decls {
    /* tests/testdata/in/traits.in:8 */ pub type Ptr :: ∗ -> ∗
    /* tests/testdata/in/traits.in:23 */ pub type Vector :: ∗ -> ∗
    /* tests/testdata/in/traits.in:81-84 */ pub type IntList = mu 'self. variant{nil (), cons (i64, Ptr 'self)}
    /* tests/testdata/in/traits.in:66-69 */ pub type Color = variant{red (), green ()}
    /* tests/testdata/in/traits.in:54-57 */ pub type Node = mu 'self. struct{val: i64, next: Ptr 'self}
    /* tests/testdata/in/traits.in:32-35 */ pub type Point = struct{x: i64, y: i64}
    /* tests/testdata/in/traits.in:14-16 */ pub trait Add {
  fn add(a: Ptr 'Self, b: Ptr 'Self) -> i64
}
    /* tests/testdata/in/traits.in:18-20 */ pub trait Indexable ['elem] {
  fn get(v: Ptr 'Self, index: i64) -> 'elem
}
    /* tests/testdata/in/traits.in:10-12 */ pub trait Size {
  fn size(s: Ptr 'Self) -> i64
}
    /* tests/testdata/in/traits.in:49-51 */ pub make_point: (i64, i64) -> Point
    /* tests/testdata/in/traits.in:122-131 */ pub test_color: () -> i64
    /* tests/testdata/in/traits.in:133-141 */ pub test_int_list: Ptr IntList -> i64
    /* tests/testdata/in/traits.in:115-120 */ pub test_node: Ptr Node -> i64
    /* tests/testdata/in/traits.in:101-113 */ pub test_point: () -> i64
    /* tests/testdata/in/traits.in:95-99 */ pub test_vector: Ptr (Vector i64) -> i64
  }
  traitImpls {
    /* tests/testdata/in/traits.in:25-29 */impl ['a] Indexable 'a for Vector 'a {
  fn get(v: Ptr (Vector 'a), index: i64) -> 'a {
  vector_get (v, index)
}
}
    /* tests/testdata/in/traits.in:37-41 */impl Size for Point {
  fn size(p: Ptr Point) -> i64 {
  + (Ptr::get p.x, Ptr::get p.y)
}
}
    /* tests/testdata/in/traits.in:43-47 */impl Add for Point {
  fn add(a: Ptr Point, b: Ptr Point) -> i64 {
  + (+ (+ (Ptr::get a.x, Ptr::get a.y), Ptr::get b.x), Ptr::get b.y)
}
}
    /* tests/testdata/in/traits.in:59-63 */impl Size for Node {
  fn size(n: Ptr Node) -> i64 {
  + (Ptr::get n.val, Size::size Ptr::get n.next)
}
}
    /* tests/testdata/in/traits.in:71-78 */impl Size for Color {
  fn size(c: Ptr Color) -> i64 {
  case Ptr::get c {
      red u -> 1
      _ -> 2}
}
}
    /* tests/testdata/in/traits.in:86-93 */impl Size for IntList {
  fn size(l: Ptr IntList) -> i64 {
  case Ptr::get l {
      nil u -> 0
      cons pair -> + (pair.0, Size::size pair.1)}
}
}
  }
  functions {
    /* tests/testdata/in/traits.in:49-51 */pub fn make_point(x: i64, y: i64) -> Point {
  struct{x = x, y = y}
}
    /* tests/testdata/in/traits.in:95-99 */pub fn test_vector(v: Ptr (Vector i64)) -> i64 {
  let a: i64 = v.get 0
  let b: i64 = Indexable::get (v, 1)
  + (a, b)
}
    /* tests/testdata/in/traits.in:101-113 */pub fn test_point() -> i64 {
  let tmp: i64 = make_point (1, 2).size ()
  let p: Point = make_point (3, 4)
  let p2: Point = make_point (5, 6)
  let a: i64 = p.size ()
  let b: i64 = p.size
  let ref_p: Ptr Point = Ptr::mk p
  let c: i64 = ref_p.size ()
  let d: i64 = ref_p.size
  let e: i64 = Size::size (Ptr::mk p)
  let f: i64 = p.add (Ptr::mk p2)
  + (+ (+ (+ (+ (+ (tmp, a), b), c), d), e), f)
}
    /* tests/testdata/in/traits.in:115-120 */pub fn test_node(n: Ptr Node) -> i64 {
  let a: i64 = n.size ()
  let b: i64 = n.size
  let c: i64 = Size::size n
  + (+ (a, b), c)
}
    /* tests/testdata/in/traits.in:122-131 */pub fn test_color() -> i64 {
  let col: Color = variant{Color red = ()}
  let a: i64 = col.size ()
  let b: i64 = col.size
  let ref_col: Ptr Color = Ptr::mk col
  let c: i64 = ref_col.size ()
  let d: i64 = ref_col.size
  let e: i64 = Size::size (Ptr::mk col)
  + (+ (+ (+ (a, b), c), d), e)
}
    /* tests/testdata/in/traits.in:133-141 */pub fn test_int_list(l: Ptr IntList) -> i64 {
  let empty: IntList = variant{IntList nil = ()}
  let a: i64 = empty.size ()
  let b: i64 = empty.size
  let c: i64 = l.size ()
  let d: i64 = l.size
  let e: i64 = Size::size l
  + (+ (+ (+ (a, b), c), d), e)
}
  }
}

